# --- Target ---
CONFIG_IDF_TARGET="esp32c3"
# ESP32-C3 无 PSRAM

# --- Flash 8MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n

# --- Partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Console: USB-Serial-JTAG (C3 native USB, GPIO18/19) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Disable WiFi/BLE runtime init (DOOM never calls esp_wifi_init) ---
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n

# --- System ---
CONFIG_FREERTOS_HZ=1000
# Smaller main task stack (DOOM engine runs in its own task)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Compiler optimization for size ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Heap ---
CONFIG_HEAP_POISONING_DISABLED=y

# --- Minimize log buffer ---
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_MAXIMUM_LEVEL_ERROR=y
