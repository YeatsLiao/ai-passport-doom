# --- Target ---
CONFIG_IDF_TARGET="esp32c3"

# --- Flash 8MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n

# --- Partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Console: USB-Serial-JTAG (C3 native USB, GPIO18/19) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Disable unused features to save RAM ---
# No BLE/WiFi needed for Doom
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n

# --- System ---
CONFIG_FREERTOS_HZ=1000
# Larger main task stack for Doom engine
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- Compiler optimization for size ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Heap ---
CONFIG_HEAP_POISONING_DISABLED=y
